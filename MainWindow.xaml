<Window x:Class="Student_Autho.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация" Height="450" Width="800"
        Icon="/Resources/icon.ico" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка окна -->
        <Grid Grid.Row="0" Background="#FF76E383">
            <Button x:Name="btnBack" HorizontalAlignment="Right" Content="Назад" Click="btnBack_Click"/>
            <Image Width="45" Height="45" HorizontalAlignment="Left" Margin="5" Source="/Resources/logo.png"/>
        </Grid>

        <!-- Frame отображает страницы из папки Pages -->
        <Frame x:Name="FrmMain" Grid.Row="1" NavigationUIVisibility="Hidden"
               ContentRendered="FrmMain_ContentRendered"/>
    </Grid>
</Window>
