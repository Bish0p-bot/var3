<Page x:Class="Student_Autho.Pages.Autho"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Autho" Background="White">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Логин:"/>
            <TextBox x:Name="txtbLogin" Width="250"/>
            <TextBlock Text="Пароль:"/>
            <PasswordBox x:Name="pswbPassword" Width="250"/>

            <!-- Элементы для капчи и таймера блокировки (будут использованы позже) -->
            <TextBlock Visibility="Hidden" x:Name="txtBlockCaptcha" Text="Капча:"/>
            <TextBox Visibility="Hidden" x:Name="txtboxCaptcha"/>
            <TextBlock HorizontalAlignment="Center" Visibility="Hidden" x:Name="txtBlockTimer"/>

            <StackPanel Orientation="Horizontal" Height="60" HorizontalAlignment="Center">
                <Button x:Name="btnEnterGuests" Width="150" Margin="5,15,5,5"
                        Content="Войти как гость" Click="btnEnterGuests_Click"/>
                <Button x:Name="btnEnter" Margin="5,15,5,5"
                        Content="Войти" Click="btnEnter_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
